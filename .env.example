NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_carpool
# Supabase: use the *session pooler* URI (Connect > Session pooler), port 5432. SSL is auto-enabled for supabase hosts.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true   # force TLS for any other hosted Postgres; DB_SSL=false to force it off
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m

MOBILE_API_URL=http://localhost:3000/v1

# Cashfree Verification Suite (Secure ID). Leave the id/secret empty to keep the dev-mode stubs.
# Sandbox only accepts Cashfree's published test data; production needs live keys + base URL
# https://api.cashfree.com/verification. Your server's public IPv4 must be whitelisted in the
# Cashfree dashboard (Developers > Two-Factor Authentication).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/verification
# Only if 2FA is set to "Public Key" (changing server IP): path to the .pem downloaded from
# Developers > Two-Factor Authentication. Keep it outside git. Leave empty for IP whitelisting.
CASHFREE_PUBLIC_KEY_PATH=

# MSG91 OTP (SMS only). Template ID: MSG91 > OTP > Templates (DLT-approved for India).
# Leave either empty to keep the dev-mode OTP stub (any 6-digit code works; blocked in production).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
